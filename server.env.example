# Copy this file to server.env. Defaults are repository-relative; change a
# value only when the server stores data/models/results elsewhere.

UAVFLOW_REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

export CONDA_ENV=uav-gam
export DATA_ROOT="${DATA_ROOT:-${UAVFLOW_REPO_ROOT}/data_remote}"
export MODEL_ROOT="${MODEL_ROOT:-${UAVFLOW_REPO_ROOT}/checkpoints}"
export OUTPUT_ROOT="${OUTPUT_ROOT:-${UAVFLOW_REPO_ROOT}/results/remote_ablation}"

# Mainland-friendly public downloads and the derived depth dataset.
export HF_ENDPOINT=https://hf-mirror.com
export DEPTH_HUB=modelscope
export DEPTH_DATASET_REPO=acetaffy123/UAV-Flow-Sim-Depth

# Choose exactly one: slurm, pbs, lsf, local.
export SCHEDULER=slurm

# Used only for SCHEDULER=local. Semicolon separates independent 4-GPU jobs.
export GPU_GROUPS='0,1,2,3;4,5,6,7'

unset UAVFLOW_REPO_ROOT
